{
  "version": 2,
  "buildCommand": "npm install",
  "devCommand": "node index.js",
  "installCommand": "npm install",
  "crons": [],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
